# ──────────────────────────────────────────
# JagaRoda Frontend — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# In Netlify, set these in:
#   Site Settings → Build & deploy → Environment variables
# ──────────────────────────────────────────

# Backend API base URL (no trailing slash)
VITE_API_BASE=https://jaga-roda-backend.vercel.app

# Google Maps API Key
# Masukkan API Key Google Maps Anda di sini jika ingin menggunakan Google Maps Embed API berbayar atau JavaScript API lanjutan.
# Dapatkan API key di Google Cloud Console: https://console.cloud.google.com/google/maps-apis
# Jika dibiarkan kosong, sistem secara otomatis berjalan dalam mode Real Google Maps Embed & Direct Navigation Links.
VITE_GOOGLE_MAPS_API_KEY=
